{{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {{
    "bg": "{background}",
    "fg": "{foreground}",
    "cursor": "{cursor}",

    "surface0": "{surface0}",
    "surface1": "{surface1}",
    "surface2": "{surface2}",
    "surface3": "{surface3}",
    "surface4": "{surface4}",
    "surface5": "{surface5}",

    "subsurface0": "{subsurface0}",
    "subsurface1": "{subsurface1}",
    "subsurface2": "{subsurface2}",

    "c0": "{color0}",
    "c1": "{color1}",
    "c2": "{color2}",
    "c3": "{color3}",
    "c4": "{color4}",
    "c5": "{color5}",
    "c6": "{color6}",
    "c7": "{color7}",
    "c8": "{color8}",
    "c9": "{color9}",
    "c10": "{color10}",
    "c11": "{color11}",
    "c12": "{color12}",
    "c13": "{color13}",
    "c14": "{color14}",
    "c15": "{color15}",

    "black": "{black}",
    "red": "{red}",
    "green": "{green}",
    "yellow": "{yellow}",
    "blue": "{blue}",
    "magenta": "{magenta}",
    "cyan": "{cyan}",
    "white": "{white}",

    "bright_black": "{bright_black}",
    "bright_red": "{bright_red}",
    "bright_green": "{bright_green}",
    "bright_yellow": "{bright_yellow}",
    "bright_blue": "{bright_blue}",
    "bright_magenta": "{bright_magenta}",
    "bright_cyan": "{bright_cyan}",
    "bright_white": "{bright_white}",

    "diff_bg_added": "#132317",
    "diff_bg_removed": "#231318"
  }},
  "theme": {{
    "primary": {{ "dark": "c2", "light": "c2" }},
    "secondary": {{ "dark": "c0", "light": "c0" }},
    "accent": {{ "dark": "c10", "light": "c10" }},

    "error": {{ "dark": "red", "light": "red" }},
    "warning": {{ "dark": "yellow", "light": "yellow" }},
    "success": {{ "dark": "green", "light": "green" }},
    "info": {{ "dark": "blue", "light": "blue" }},

    "text": {{ "dark": "fg", "light": "fg" }},
    "textMuted": {{ "dark": "surface4", "light": "surface4" }},

    "background": {{ "dark": "bg", "light": "bg" }},
    "backgroundPanel": {{ "dark": "subsurface1", "light": "subsurface1" }},
    "backgroundElement": {{ "dark": "subsurface0", "light": "subsurface0" }},

    "border": {{ "dark": "subsurface0", "light": "subsurface0" }},
    "borderActive": {{ "dark": "c2", "light": "c2" }},
    "borderSubtle": {{ "dark": "subsurface2", "light": "subsurface2" }},

    "diffAdded": {{ "dark": "green", "light": "green" }},
    "diffRemoved": {{ "dark": "red", "light": "red" }},
    "diffContext": {{ "dark": "surface3", "light": "surface3" }},
    "diffHunkHeader": {{ "dark": "c0", "light": "c0" }},
    "diffHighlightAdded": {{ "dark": "c9", "light": "c9" }},
    "diffHighlightRemoved": {{ "dark": "c13", "light": "c13" }},
    "diffAddedBg": {{ "dark": "diff_bg_added", "light": "diff_bg_added" }},
    "diffRemovedBg": {{ "dark": "diff_bg_removed", "light": "diff_bg_removed" }},
    "diffContextBg": {{ "dark": "subsurface1", "light": "subsurface1" }},
    "diffLineNumber": {{ "dark": "surface3", "light": "surface3" }},
    "diffAddedLineNumberBg": {{ "dark": "subsurface0", "light": "subsurface0" }},
    "diffRemovedLineNumberBg": {{ "dark": "subsurface0", "light": "subsurface0" }},

    "markdownText": {{ "dark": "fg", "light": "fg" }},
    "markdownHeading": {{ "dark": "c2", "light": "c2" }},
    "markdownLink": {{ "dark": "c12", "light": "c12" }},
    "markdownLinkText": {{ "dark": "c10", "light": "c10" }},
    "markdownCode": {{ "dark": "c9", "light": "c9" }},
    "markdownBlockQuote": {{ "dark": "surface3", "light": "surface3" }},
    "markdownEmph": {{ "dark": "c11", "light": "c11" }},
    "markdownStrong": {{ "dark": "c10", "light": "c10" }},
    "markdownHorizontalRule": {{ "dark": "subsurface0", "light": "subsurface0" }},
    "markdownListItem": {{ "dark": "c12", "light": "c12" }},
    "markdownListEnumeration": {{ "dark": "surface4", "light": "surface4" }},
    "markdownImage": {{ "dark": "c0", "light": "c0" }},
    "markdownImageText": {{ "dark": "surface4", "light": "surface4" }},
    "markdownCodeBlock": {{ "dark": "fg", "light": "fg" }},

    "syntaxComment": {{ "dark": "surface4", "light": "surface4" }},
    "syntaxKeyword": {{ "dark": "c1", "light": "c1" }},
    "syntaxFunction": {{ "dark": "c4", "light": "c4" }},
    "syntaxVariable": {{ "dark": "fg", "light": "fg" }},
    "syntaxString": {{ "dark": "c2", "light": "c2" }},
    "syntaxNumber": {{ "dark": "c11", "light": "c11" }},
    "syntaxType": {{ "dark": "c6", "light": "c6" }},
    "syntaxOperator": {{ "dark": "c6", "light": "c6" }},
    "syntaxPunctuation": {{ "dark": "surface4", "light": "surface4" }}
  }}
}}
